APP_NAME=Financial Earnings RAG
DEBUG=false

DATABASE_URL=sqlite+aiosqlite:///./earnings.db

CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=earnings_reports

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
USE_MOCK_LLM=true

EMBEDDING_MODEL=all-MiniLM-L6-v2
CHUNK_SIZE=512
CHUNK_OVERLAP=50
TOP_K_RETRIEVAL=5

ENABLE_METRICS=true
