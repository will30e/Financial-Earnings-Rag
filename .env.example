# Copy to backend/.env and fill in values

# App
DEBUG=false

# Database (SQLite for local, PostgreSQL for prod)
DATABASE_URL=sqlite+aiosqlite:///./earnings.db

# Vector Store
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=earnings_reports

# LLM — set OPENAI_API_KEY to enable full generation; leave blank for mock mode
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
USE_MOCK_LLM=true

# Pipeline tuning
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHUNK_SIZE=512
CHUNK_OVERLAP=50
TOP_K_RETRIEVAL=5

# AWS (for deployment)
AWS_ACCOUNT_ID=
AWS_DEFAULT_REGION=us-east-1
EKS_CLUSTER_NAME=earnings-rag-cluster
